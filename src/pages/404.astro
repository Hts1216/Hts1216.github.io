---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="页面未找到" description="这个页面不存在，可能已经移动。" />
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<Header />
		<main>
			<h1>404 · 页面未找到</h1>
			<p>这个页面不存在，可能已经移动。</p>
			<p><a href="/">返回首页</a>，或<a href="/blog/">浏览文章</a>。</p>
		</main>
		<Footer />
	</body>
</html>
